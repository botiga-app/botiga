{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    { "path": "/api/cron/recovery",         "schedule": "0 9 * * *" },
    { "path": "/api/cron/alerts",           "schedule": "0 8 * * *" },
    { "path": "/api/cron/escalate-floors",  "schedule": "*/5 * * * *" },
    { "path": "/api/cron/won-abandoned",    "schedule": "0 * * * *" }
  ]
}
